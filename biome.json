{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!!**/dist", "!public"]
  },
  "plugins": ["./biome-plugins/view-only-presenter.grit"],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended",
      "test": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "style": {
        "noDefaultExport": "error",
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 120
          }
        },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "**/components/*/**",
                  "**/ui/*/**",
                  "**/pages/*/**",
                  "!**/*.module.css"
                ],
                "message": "Import a component by its folder, not its inner files."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["*.config.ts", "server/*.config.ts", "server/src/index.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["src/**/index.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": {
                    "importNames": [
                      "use",
                      "useCallback",
                      "useContext",
                      "useDeferredValue",
                      "useEffect",
                      "useLayoutEffect",
                      "useMemo",
                      "useReducer",
                      "useRef",
                      "useState",
                      "useSyncExternalStore",
                      "useTransition"
                    ],
                    "message": "Views only render. Put hooks in logic/usePresenter.ts."
                  }
                },
                "patterns": [
                  {
                    "group": [
                      "**/components/*/**",
                      "**/ui/*/**",
                      "**/pages/*/**",
                      "!**/*.module.css"
                    ],
                    "message": "Import a component by its folder, not its inner files."
                  },
                  {
                    "group": [
                      "**/hooks/**",
                      "**/api/**",
                      "**/api",
                      "**/tasks/**",
                      "**/stores/**",
                      "./use*",
                      "./logic/**",
                      "!./logic/usePresenter"
                    ],
                    "message": "A view imports only its own ./logic/usePresenter."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/components/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/components/*/**",
                      "**/ui/*/**",
                      "**/pages/*/**",
                      "!**/*.module.css"
                    ],
                    "message": "Import a component by its folder, not its inner files."
                  },
                  {
                    "group": ["**/pages/**", "**/pages"],
                    "message": "components/ must not import from pages/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/components/*/**",
                      "**/ui/*/**",
                      "**/pages/*/**",
                      "!**/*.module.css"
                    ],
                    "message": "Import a component by its folder, not its inner files."
                  },
                  {
                    "group": [
                      "**/api/**",
                      "**/api",
                      "**/hooks/**",
                      "**/stores/**",
                      "**/tasks/**",
                      "**/components/**",
                      "**/pages/**"
                    ],
                    "message": "ui/ must not depend on app code."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/**/tasks/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "Tasks are plain TypeScript. Don't import React.",
                  "zustand": "Tasks use the stores in stores/. Don't import zustand.",
                  "zustand/vanilla": "Tasks use the stores in stores/. Don't import zustand."
                },
                "patterns": [
                  {
                    "group": [
                      "**/components/*/**",
                      "**/ui/*/**",
                      "**/pages/*/**",
                      "!**/*.module.css"
                    ],
                    "message": "Import a component by its folder, not its inner files."
                  },
                  {
                    "group": [
                      "**/hooks/**",
                      "**/components/**",
                      "**/ui/**",
                      "**/pages/**",
                      "../use*",
                      "../../use*",
                      "*.css"
                    ],
                    "message": "Tasks don't import hooks, presenters, views, or CSS."
                  },
                  {
                    "group": ["**/api/**", "**/api", "!**/api/types"],
                    "message": "Tasks get API implementations as arguments. Import only types from api/types."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["server/src/tasks/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "hono": "Tasks are plain TypeScript. Keep HTTP in app.ts."
                },
                "patterns": [
                  {
                    "group": [
                      "hono/**",
                      "../app",
                      "../cache/**",
                      "../favorites/**",
                      "../favoritesRoutes",
                      "../sessions/**",
                      "../authRoutes",
                      "../originGuard",
                      "../index"
                    ],
                    "message": "Tasks get their dependencies as arguments."
                  },
                  {
                    "group": ["../tvmaze/**", "!../tvmaze/types"],
                    "message": "Tasks import only types from tvmaze/types."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/api/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "api/ is plain TypeScript. Don't import React.",
                  "zustand": "api/ is plain TypeScript. Keep state in stores/."
                },
                "patterns": [
                  {
                    "group": [
                      "**/hooks/**",
                      "**/tasks/**",
                      "**/stores/**",
                      "**/components/**",
                      "**/ui/**",
                      "**/pages/**"
                    ],
                    "message": "api/ must not import app code."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/stores/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "Stores are data only. Don't import React.",
                  "zustand": "Stores are plain TypeScript: use zustand/vanilla. React binds them in hooks/."
                },
                "patterns": [
                  {
                    "group": [
                      "**/components/*/**",
                      "**/ui/*/**",
                      "**/pages/*/**",
                      "!**/*.module.css"
                    ],
                    "message": "Import a component by its folder, not its inner files."
                  },
                  {
                    "group": [
                      "**/hooks/**",
                      "**/tasks/**",
                      "**/components/**",
                      "**/ui/**",
                      "**/pages/**"
                    ],
                    "message": "Stores hold data only. The rules that change them are tasks."
                  },
                  {
                    "group": ["**/api/**", "**/api", "!**/api/types"],
                    "message": "Stores import only types from api/types."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "cssModules": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":NODE:", ":PACKAGE:"],
              ":BLANK_LINE:",
              ["**/components/**", "**/ui/**"],
              ":BLANK_LINE:",
              ["**/hooks/**", "**/tasks/**", "**/api/**", "**/stores/**"],
              ":BLANK_LINE:",
              ["./**", "!**/*.css"],
              ":BLANK_LINE:",
              "**/*.css"
            ]
          }
        }
      }
    }
  }
}
